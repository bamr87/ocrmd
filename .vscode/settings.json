{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  // Test explorer: pytest over tests/ (the OCR-dependent cases skip where no engine is installed)
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-p", "no:cacheprovider"],
  // Scan data lives in the repo root; keep it out of search, watchers and the explorer
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.egg-info": true,
    ".playwright-mcp": true,
    "ocrmd.db-wal": true,
    "ocrmd.db-shm": true
  },
  "search.exclude": {
    "raw/**": true,
    "processed/**": true,
    "ocr/**": true,
    "llm/**": true,
    "inbox/**": true,
    "ocrmd.log*": true
  },
  "files.watcherExclude": {
    "**/raw/**": true,
    "**/processed/**": true,
    "**/ocr/**": true,
    "**/llm/**": true,
    "**/inbox/**": true
  },
  "files.associations": { "*.md.tmp": "markdown", "ocrmd.example.toml": "toml" },
  "[python]": { "editor.rulers": [120] },
  "[javascript]": { "editor.tabSize": 2 }
}
