{
  "expo": {
    "name": "ocrmd",
    "slug": "ocrmd",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ocrmd",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "io.github.bamr87.ocrmd",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "ocrmd sends your page photos to the ocrmd server on your own computer over the local network.",
        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true }
      }
    },
    "android": {
      "package": "io.github.bamr87.ocrmd",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ocrmd photographs the pages you scan, and reads the pairing QR code your computer shows.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": true } }
      ]
    ]
  }
}
